{
  "tetra.improvement.upgradednetherite/gold.name": "Gilded Netherite Runes",
  "tetra.improvement.upgradednetherite/gold.description": "• Increased damage to Piglins and Hoglins\\n• Bonus to Looting and Fortune\\n• Shield damages Piglins and Hoglins on block",
  "tetra.improvement.upgradednetherite/fire.name": "Magmatic Netherite Runes",
  "tetra.improvement.upgradednetherite/fire.description": "• Increased damage to burning targets\\n• Extends burn duration for Fire Aspect or Flame\\n• Auto-smelting\\n• Shield burns attackers and prevents catching fire",
  "tetra.improvement.upgradednetherite/ender.name": "Voidwalker Netherite Runes",
  "tetra.improvement.upgradednetherite/ender.description": "• Increased damage and Looting against natives of the End\\n• Prevents target teleportation\\n• Faster mining and Fortune in the End or of End blocks\\n• Shield summons and stuns enemies, preventing teleportation",
  "tetra.improvement.upgradednetherite/water.name": "Abyssal Netherite Runes",
  "tetra.improvement.upgradednetherite/water.description": "• Increased damage to fire-immune creatures and Endermen\\n• Increased damage underwater \\n• Increased mining speed underwater\\n• Right-click lava to freeze it\\n• Shield damages fire-immune creatures and Endermen on block",
  "tetra.improvement.upgradednetherite/wither.name": "Blighted Netherite Runes",
  "tetra.improvement.upgradednetherite/wither.description": "• Withers targets\\n• Increased damage to withering targets\\n• Shield withers attackers",
  "tetra.improvement.upgradednetherite/poison.name": "Vile Netherite Runes",
  "tetra.improvement.upgradednetherite/poison.description": "• Poisons targets\\n• Increased damage to poisoned targets\\n• Shield poisons attackers",
  "tetra.improvement.upgradednetherite/phantom.name": "Phantasmal Netherite Runes",
  "tetra.improvement.upgradednetherite/phantom.description": "• Increased damage to Phantoms and other flying creatures\\n• Detects nearby enemies\\n• Increases reach\\n• Shield damages flying creatures on block",
  "tetra.improvement.upgradednetherite/feather.name": "Skyseeker Netherite Runes",
  "tetra.improvement.upgradednetherite/feather.description": "• Knocks back and levitates enemies (shift-right-click to disable)\\n• Increased damage to targets in the air\\n• Pulls items towards you (shift-right-click to disable)\\n• Bow pulls enemies towards you\\n• Shield knocks back and levitates enemies",
  "tetra.improvement.upgradednetherite/echo.name": "Resonant Netherite Runes",
  "tetra.improvement.upgradednetherite/echo.description": "• Increased damage to Sculk mobs\\n• Increased XP drops on kill\\n• Increased mining speed below y=0 or in Deep Dark\\n• Mining is silent\\n• Shield heals while in the Deep Dark\\n• Stays in inventory on death",
  "tetra.improvement.upgradednetherite/corrupt.name": "Corrupted Netherite Runes",
  "tetra.improvement.upgradednetherite/corrupt.description": "• Damage, looting, fortune, and mining speed scale with number of Corrupted Netherite armor pieces\\n• Shield damages enemies scaling with number of Corrupted Netherite armor pieces",
  "tetra.improvement.upgradednetherite/radiant.name": "Radiant Netherite Runes",
  "tetra.improvement.upgradednetherite/radiant.description": "• Increased damage to undead, Wither and Sculk mobs\\n• Reduces duration of negative effects on hit\\n• Purifies and destroys infection\\n• Grants Night Vision on right-click\\n• Shield damages undead, Wither and Sculk mobs on block",
  "tetra.improvement.upgradednetherite/ultimate.name": "Paragon Netherite Runes",
  "tetra.improvement.upgradednetherite/ultimate.description": "• All effects",
  "tetra.improvement.upgradednetherite/removed.name": "Removed Netherite Runes",
  "tetra.improvement.upgradednetherite/removed.description": "No effect",

